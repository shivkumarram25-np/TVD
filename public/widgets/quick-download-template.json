{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.5",
  "body": [
    {
      "type": "TextBlock",
      "text": "Nepal TVD",
      "weight": "Bolder",
      "size": "Medium",
      "color": "Accent"
    },
    {
      "type": "TextBlock",
      "text": "${statusText}",
      "wrap": true,
      "spacing": "Small"
    },
    {
      "type": "Input.Text",
      "id": "videoUrl",
      "placeholder": "${placeholderText}"
    }
  ],
  "actions": [
    {
      "type": "Action.Execute",
      "title": "Download",
      "verb": "quick-download"
    },
    {
      "type": "Action.OpenUrl",
      "title": "Open App",
      "url": "https://nepal-tvd.pages.dev/?widget=open"
    }
  ]
}
